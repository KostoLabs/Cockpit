{
  "name": "klai-cockpit",
  "productName": "KostoLabs AI Cockpit",
  "version": "0.5.0",
  "description": "Cockpit desktop Hermes habillé au design system KostoLabs AI · Fin.",
  "main": "main.js",
  "author": "KostoLabs Company",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/setup-fonts.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "fonts": "node scripts/setup-fonts.js",
    "icons": "sh scripts/setup-icons.sh",
    "test": "node --test \"tests/*.test.js\"",
    "test:plugin": "python3 -m unittest discover -s plugins/ctx_handover/tests -t plugins",
    "check": "node scripts/check.js",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:mac:zip": "python3 scripts/buildmac.py"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  }
}
